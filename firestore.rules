rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Public read and authorized catalog management
    match /songs/{songId} {
      allow read: if true;
      allow write: if isValidId(songId);
    }

    match /artists/{artistId} {
      allow read: if true;
      allow write: if isValidId(artistId);
    }

    match /albums/{albumId} {
      allow read: if true;
      allow write: if isValidId(albumId);
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isValidId(collectionId);
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isValidId(galleryId);
    }

    match /quotes/{quoteId} {
      allow read: if true;
      allow write: if isValidId(quoteId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    match /merch/{merchId} {
      allow read: if true;
      allow write: if isValidId(merchId);
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
